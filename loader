local function click()
    local c = Char()
    if not c then return end
    if not State.AimPos then return end
    for _, tool in ipairs(c:GetChildren()) do
        if tool:IsA("Tool") then
            for _, prefix in ipairs({"FS_","SW_","DF_"}) do
                pcall(function()
                    RS.Chest.Remotes.Functions.SkillAction:InvokeServer(
                        prefix .. tool.Name .. "_M1",
                        {MouseHit = State.AimPos}
                    )
                end)
            end
        end
    end
end

local function autoskill()
    if Config.SkillZ then Key("Z") end
    if Config.SkillX then Key("X") end
    if Config.SkillC then Key("C") end
    if Config.SkillV then Key("V") end
    if Config.SkillF then Key("F") end
    if Config.SkillB then Key("B") end
    if Config.SkillE then Key("E") end
end

