local function Slider(parent, name, label, key, min, max, decimals)
    local row = New("Frame", {
        Parent = parent,
        Size = UDim2.new(1, -8, 0, 44),
        Position = UDim2.new(0, 4, 0, Y[name]),
        BackgroundColor3 = Color3.fromRGB(22, 22, 28),
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
    })
    Corner(row, 6)
    local lbl = New("TextLabel", {
        Parent = row,
        Size = UDim2.new(0.65, 0, 0, 20),
        Position = UDim2.new(0, 12, 0, 4),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Color3.fromRGB(220, 220, 230),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLbl = New("TextLabel", {
        Parent = row,
        Size = UDim2.new(0.3, 0, 0, 20),
        Position = UDim2.new(0.7, 0, 0, 4),
        BackgroundTransparency = 1,
        Text = tostring(Config[key]),
        TextColor3 = Color3.fromRGB(240, 200, 90),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    local bar = New("Frame", {
        Parent = row,
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 30),
        BackgroundColor3 = Color3.fromRGB(50, 50, 60),
        BorderSizePixel = 0,
    })
    Corner(bar, 3)
    local fill = New("Frame", {
        Parent = bar,
        Size = UDim2.new((Config[key]-min)/(max-min), 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(240, 200, 90),
        BorderSizePixel = 0,
    })
    Corner(fill, 3)

    local dragging = false
    local function updateFromX(x)
        local abs = bar.AbsolutePosition.X
        local w = bar.AbsoluteSize.X
        local pct = math.clamp((x - abs) / w, 0, 1)
        local val = min + pct * (max - min)
        if decimals then
            val = math.floor(val * (10^decimals)) / (10^decimals)
        else
            val = math.floor(val)
        end
        Config[key] = val
        valLbl.Text = tostring(val)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        SaveConfig()
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    Y[name] = Y[name] + 48
    parent.CanvasSize = UDim2.new(0, 0, 0, Y[name] + 20)
end

