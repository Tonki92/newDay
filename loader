local FOLDER = "TonKiHub"
if not isfolder(FOLDER) then pcall(makefolder, FOLDER) end
local SAVE_FILE = FOLDER .. "/config.json"

local function SaveConfig()
    if not writefile then return end
    pcall(function() writefile(SAVE_FILE, HttpService:JSONEncode(Config)) end)
end

local function LoadConfig()
    if not (isfile and isfile(SAVE_FILE)) then return end
    pcall(function()
        local d = HttpService:JSONDecode(readfile(SAVE_FILE))
        for k, v in pairs(d) do Config[k] = v end
    end)
end
