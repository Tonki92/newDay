local function ToolExists(name)
    if not name then return false end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp and bp:FindFirstChild(name) then return true end
    local c = Char()
    if c and c:FindFirstChild(name) then return true end
    return false
end

local function EquipByName(name)
    if not name then return false end
    local c = Char()
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and t.Name == name then return true end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t.Name == name then
                pcall(function() Hum():EquipTool(t) end)
                return true
            end
        end
    end
    return false
end

local function CurrentTool()
    local c = Char()
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then return t end
    end
end

local function ClickMob()
    local tool = CurrentTool()
    if not tool then return end
    local hit = State.AimPos or (HRP() and HRP().CFrame)
    for _, prefix in ipairs({"FS_","SW_","DF_","GH_"}) do
        pcall(function()
            RS.Chest.Remotes.Functions.SkillAction:InvokeServer(
                prefix .. tool.Name .. "_M1", {MouseHit = hit})
        end)
    end
end

