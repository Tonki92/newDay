pcall(function()
    local mt = getrawmetatable(game)
    local oldNC = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        if method == "InvokeServer" and tostring(self) == "SkillAction" then
            if (State.AimPosRaw and (Config.AutoAim or AnyFarmActive())) then
                if typeof(args[2]) == "table" and args[2].Type == "Up" then
                    args[2].MouseHit = State.AimPos or args[2].MouseHit
                end
            end
        end
        return oldNC(self, unpack(args))
    end)
    setreadonly(mt, true)
end)

