--[[
    TONKI HUB — PUZZLE DETECTOR v2
    Chạy TRƯỚC khi nhận quest sea beast, để nó hook sẵn.
    Khi puzzle hiện ra, script tự nhận diện + log.
]]

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local CG      = game:GetService("CoreGui")
local SG      = game:GetService("StarterGui")
local LP      = Players.LocalPlayer

local TraceLog = {}
local TraceOn  = true
local KnownGuis = {}

-- Hook namecall — log MỌI FireServer/InvokeServer có number args
local mt = getrawmetatable(game)
local oldNC = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if TraceOn and (method == "InvokeServer" or method == "FireServer") then
        local numCount = 0
        for _, a in ipairs(args) do
            if type(a) == "number" then numCount = numCount + 1 end
        end
        if numCount >= 1 and numCount <= 3 then
            local full = "?"
            pcall(function() full = self:GetFullName() end)
            table.insert(TraceLog, {
                t = tick(), method = method,
                remote = tostring(self), full = full, args = args,
            })
            if #TraceLog > 1000 then table.remove(TraceLog, 1) end
        end
    end
    return oldNC(self, ...)
end)
setreadonly(mt, true)

