local draggingToggle, dragStart, startPos
ToggleBtn.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        draggingToggle = false
        dragStart = i.Position
        startPos = ToggleBtn.AbsolutePosition
        local conn
        conn = i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then
                conn:Disconnect()
                if not draggingToggle then Main.Visible = not Main.Visible end
            end
        end)
    end
end)
ToggleBtn.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseMovement
    or i.UserInputType == Enum.UserInputType.Touch then
        if dragStart and (i.Position - dragStart).Magnitude > 4 then
            draggingToggle = true
            local d = i.Position - dragStart
            ToggleBtn.Position = UDim2.new(0, startPos.X + d.X, 0, startPos.Y + d.Y)
        end
    end
end)

