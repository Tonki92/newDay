panel.Size = UDim2.new(0, 340, 0, 460)
panel.Position = UDim2.new(0, 20, 0.1, 0)
panel.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
panel.BorderSizePixel = 0
panel.Active = true
panel.Draggable = true
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 10)
local st = Instance.new("UIStroke", panel)
st.Color = Color3.fromRGB(245, 205, 95); st.Thickness = 1.2

local title = Instance.new("TextLabel", panel)
title.Size = UDim2.new(1, -20, 0, 26)
title.Position = UDim2.new(0, 10, 0, 6)
title.BackgroundTransparency = 1
title.Text = "◈ RAW LOGGER"
title.TextColor3 = Color3.fromRGB(245, 205, 95)
title.Font = Enum.Font.GothamBold
title.TextSize = 13
title.TextXAlignment = Enum.TextXAlignment.Left

local logBox = Instance.new("ScrollingFrame", panel)
logBox.Size = UDim2.new(1, -20, 1, -130)
logBox.Position = UDim2.new(0, 10, 0, 36)
logBox.BackgroundColor3 = Color3.fromRGB(0,0,0)
logBox.BorderSizePixel = 0
logBox.ScrollBarThickness = 4
logBox.CanvasSize = UDim2.new(0,0,0,0)
logBox.AutomaticCanvasSize = Enum.AutomaticSize.Y

local lay = Instance.new("UIListLayout", logBox)
lay.SortOrder = Enum.SortOrder.LayoutOrder
lay.Padding = UDim.new(0, 2)

local lines = {}
local function addLine(t)
    table.insert(lines, t)
    local l = Instance.new("TextLabel", logBox)
    l.Size = UDim2.new(1, -6, 0, 14)
    l.BackgroundTransparency = 1
    l.Text = t
    l.TextColor3 = Color3.fromRGB(210, 210, 210)
    l.Font = Enum.Font.Code
    l.TextSize = 9
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextWrapped = false
    logBox.CanvasPosition = Vector2.new(0, 1e6)
end

local function mkBtn(text, y, cb, parent)
    local b = Instance.new("TextButton", parent or panel)
    b.Size = UDim2.new(0.47, 0, 0, 26)
    b.Position = UDim2.new(0, 10, 1, y)
    b.BackgroundColor3 = Color3.fromRGB(30, 26, 12)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(245, 205, 95)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 10
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
    b.MouseButton1Click:Connect(function() if cb then pcall(cb) end end)
    return b
end
local function mkBtnR(text, y, cb, parent)
    local b = mkBtn(text, y, cb, parent)
    b.Position = UDim2.new(0.51, 0, 1, y)
    return b
end

mkBtn("START CAPTURE (8s)", -92, function()
    Capture = true
    CaptureStart = tick()
    addLine(">>> CAPTURE STARTED. Ấn tile trên puzzle ngay!")
    task.delay(CaptureDur, function()
        Capture = false
        addLine(">>> CAPTURE ENDED")
    end)
end)

mkBtnR("STOP", -92, function()
    Capture = false
    addLine(">>> STOPPED")
end)

mkBtn("DUMP + COPY", -62, function()
    local txt = table.concat(lines, "\n")
    if setclipboard then pcall(function() setclipboard(txt) end) end
    if writefile then pcall(function() writefile("TonKi_RawLog.txt", txt) end) end
    addLine("[Dump] " .. #lines .. " lines copied")
end)

mkBtnR("CLEAR", -62, function()
    lines = {}
    for _, c in ipairs(logBox:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
    Log = {}
    addLine("[Cleared]")
end)

mkBtn("SCAN TILE BUTTONS", -32, function()
    local plg = LP:FindFirstChild("PlayerGui")
    if not plg then return end
    -- tìm trong MainGui
    local mg = plg:FindFirstChild("MainGui")
    if not mg then addLine("MainGui not found"); return end
    local count = 0
    for _, g in ipairs(mg:GetDescendants()) do
        if g:IsA("ImageButton") then
            -- log connections
            for _, sig in ipairs({"MouseButton1Click","MouseButton1Down","Activated","InputBegan","TouchTap"}) do
                local ok, conns = pcall(getconnections, g[sig])
                if ok and conns and #conns > 0 then
                    addLine(("[CONN] %s | %s | %d"):format(g:GetFullName(), sig, #conns))
                    count = count + 1
                end
            end
        end
    end
    addLine("[Scan] " .. count .. " tile connections found")
end)

mkBtnR("CLOSE", -32, function() gui:Destroy() end)

-- realtime sync
spawn(function()
    local last = 0
    while gui.Parent do
        task.wait(0.25)
        if #Log > last then
            for i = last + 1, #Log do
                addLine(Log[i])
            end
            last = #Log
        end
    end
end)

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification",
        {Title="TonKi", Text="Bấm START CAPTURE rồi ấn tile.", Duration=4})
end)

return Log
