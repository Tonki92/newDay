function UISystem:AddSection(text, parent)
    local section = Instance.new("TextLabel")
    section.Name = text
    section.Size = UDim2.new(1, 0, 0, 30)
    section.BackgroundColor3 = Color3.fromRGB(200, 100, 180)
    section.TextColor3 = Color3.fromRGB(0, 0, 0)
    section.TextSize = 12
    section.Font = Enum.Font.GothamBold
    section.Text = "[ " .. text .. " ]"
    section.BorderColor3 = Color3.fromRGB(250, 250, 250)
    section.BorderSizePixel = 1
    section.Parent = parent
end

function UISystem:AddToggle(label, key, parent, callback)
    local btn = Instance.new("TextButton")
    btn.Name = label
    btn.Size = UDim2.new(1, 0, 0, 25)
    btn.BackgroundColor3 = TonKi.GetSetting(key) and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(5, 5, 5)
    btn.TextColor3 = Color3.fromRGB(250, 250, 250)
    btn.TextSize = 11
    btn.Font = Enum.Font.Ubuntu
    btn.Text = label
    btn.BorderColor3 = Color3.fromRGB(250, 250, 250)
    btn.BorderSizePixel = 1
    btn.Parent = parent
    
    btn.MouseButton1Click:Connect(function()
        TonKi.SetSetting(key, not TonKi.GetSetting(key))
        btn.BackgroundColor3 = TonKi.GetSetting(key) and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(5, 5, 5)
        if callback then callback() end
    end)
end

function UISystem:AddSlider(label, key, minVal, maxVal, parent)
    local container = Instance.new("TextButton")
    container.Name = label
    container.Size = UDim2.new(1, 0, 0, 30)
    container.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
    container.Text = label .. ": " .. TonKi.GetSetting(key)
    container.TextColor3 = Color3.fromRGB(250, 250, 250)
    container.TextSize = 11
    container.Font = Enum.Font.Ubuntu
    container.BorderColor3 = Color3.fromRGB(250, 250, 250)
    container.BorderSizePixel = 1
    container.Parent = parent
    
    container.MouseButton1Click:Connect(function()
        local value = TonKi.GetSetting(key)
        value = value + 10
        if value > maxVal then value = minVal end
        TonKi.SetSetting(key, value)
        container.Text = label .. ": " .. value
    end)
end

