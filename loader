local function ScanMobs(filterLv)
    local out = {}
    local mf = workspace:FindFirstChild("Monster")
    if not mf then return out end
    for _, folder in ipairs(mf:GetChildren()) do
        if folder:IsA("Folder") and not IsPlayer(folder) then
            for _, m in ipairs(folder:GetChildren()) do
                if m:IsA("Model") and not IsPlayer(m) then
                    local h = m:FindFirstChildOfClass("Humanoid")
                    local hrp = m:FindFirstChild("HumanoidRootPart")
                    if h and hrp and h.Health > 0 then
                        local lv = parseLv(m.Name)
                        if lv and (not filterLv or lv == filterLv) then
                            table.insert(out, {model=m,hrp=hrp,hum=h,name=m.Name,lv=lv,dist=Dist(hrp.Position)})
                        end
                    end
                end
            end
        end
    end
    table.sort(out, function(a,b) return a.dist < b.dist end)
    return out
end

