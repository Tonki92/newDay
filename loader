--=========================
RunService.Stepped:Connect(function()
    if not Config.AutoFarmLevel then State.QuestTaken = false; return end

    -- Auto ấn Repeat Quest
    if tick() - State.LastRepeatCheck >= 0.5 then
        State.LastRepeatCheck = tick()
        local plg = LP:FindFirstChild("PlayerGui")
        if plg then
            for _, g in ipairs(plg:GetDescendants()) do
                if g:IsA("TextLabel") and g.Text:find("Repeat Quest") then
                    local root = g
                    for _ = 1, 4 do if root.Parent then root = root.Parent end end
                    for _, btn in ipairs(root:GetDescendants()) do
                        if btn:IsA("TextButton") and (btn.Text == "Yes" or btn.Text:lower() == "yes") then
                            for _, sig in ipairs({"MouseButton1Up","MouseButton1Down","MouseButton1Click","Activated"}) do
                                local ok, conns = pcall(getconnections, btn[sig])
                                if ok then for _, cc in ipairs(conns) do pcall(function() cc:Fire() end) end end
                            end
                        end
                    end
                end
            end
        end
    end

    local q, sea = FindQuest()
    if not q then return end
    State.QuestInfo = q
    local mobLv, questName = q[3], q[4]
    local qx, qy, qz = q[5], q[6], q[7]
    local editNameMob = "Lv. " .. mobLv .. "]"

    -- Take quest (không chờ)
    if not State.QuestTaken then
        TakeQuest(questName)
    end

    local hrp = HRP()
    if not hrp then return end

    -- TP tới khu quest (safe spot)
    hrp.CFrame = CFrame.new(qx, qy, qz)

    -- Quét mob (dùng logic gốc: duyệt folder)
    local mf = workspace:FindFirstChild("Monster")
    if not mf then return end
    local found = false
    for _, folder in ipairs(mf:GetChildren()) do
        if folder:IsA("Folder") and not IsPlayer(folder) then
            for _, mob in ipairs(folder:GetChildren()) do
                if mob:IsA("Model") and not IsPlayer(mob) then
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    local mhrp = mob:FindFirstChild("HumanoidRootPart")
                    if hum and mhrp and hum.Health > 0 and mob.Name:find(editNameMob) then
                        found = true
                        pcall(function() hum.WalkSpeed = 300 end)
                        hrp.CFrame = mhrp.CFrame * CFrame.new(0, Config.FarmHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        if (mhrp.Position - hrp.Position).Magnitude < 50 then
                            State.AimPos = mhrp.CFrame
                            State.AimPosRaw = mhrp.Position
                        end
                        statusLbl.Text = "Target: " .. mob.Name
                        statLbl.Text = "Sea " .. sea .. " | Lv " .. mobLv
                        break
                    end
                end
            end
            if found then break end
        end
    end

    if not found then
        State.AimPos = nil
        State.AimPosRaw = nil
        statusLbl.Text = "Safe Spot — chờ mob lv " .. mobLv
        statLbl.Text = "Sea " .. sea .. " | idle"
    end
end)

