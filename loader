local function notif(t, s, d)
    pcall(function() SG:SetCore("SendNotification", {Title=t, Text=s, Duration=d or 3}) end)
end
local function Char() return LP.Character or LP.CharacterAdded:Wait() end
local function HRP()  local c = Char() return c and c:FindFirstChild("HumanoidRootPart") end
local function Hum()  local c = Char() return c and c:FindFirstChildOfClass("Humanoid") end
local function Pos()  local h = HRP() return h and h.Position or Vector3.zero end
local function Dist(p) return (p - Pos()).Magnitude end
local function Key(k)
    VIM:SendKeyEvent(true, k, false, game); task.wait(0.02)
    VIM:SendKeyEvent(false, k, false, game)
end
local function IsPlayer(obj)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character and (obj == pl.Character or obj:IsDescendantOf(pl.Character)) then
            return true
        end
    end
    return false
end
local function parseLv(name)
    local lv = name:match("Lv%.%s*(%d+)")
    return tonumber(lv)
end

