local function AimAt(pos)
    State.AimPos = pos and CFrame.new(pos) or nil
    State.AimPosRaw = pos
end

local function ClickMob()
    local char = Char()
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local hit = State.AimPos or (HRP() and HRP().CFrame)
            for _, prefix in ipairs({"FS_", "SW_", "DF_", "GH_"}) do
                local args = { prefix .. tool.Name .. "_M1", { MouseHit = hit } }
                pcall(function()
                    RS.Chest.Remotes.Functions.SkillAction:InvokeServer(unpack(args))
                end)
            end
        end
    end
end

local function UseSkills()
    if Config.SkillZ then Key("Z") end
    if Config.SkillX then Key("X") end
    if Config.SkillC then Key("C") end
    if Config.SkillV then Key("V") end
    if Config.SkillF then Key("F") end
    if Config.SkillB then Key("B") end
    if Config.SkillE then Key("E") end
end

local function EquipToolByName(name)
    local char = Char()
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == name then return true end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == name then
                pcall(function()
                    Hum():EquipTool(tool)
                end)
                return true
            end
        end
    end
    return false
end

