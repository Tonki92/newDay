local function Cycler(parent, label, key, list)
    local row = New("TextButton", {
        Parent = parent, Size = UDim2.new(1,-2,0,28),
        BackgroundColor3 = Color3.fromRGB(20,20,26),
        BackgroundTransparency = math.min(0.9, Config.MenuTransparency),
        Text = "", AutoButtonColor = false,
    })
    Corner(row, 5)
    New("TextLabel", {
        Parent = row, Size = UDim2.new(0.5,0,1,0), Position = UDim2.new(0,10,0,0),
        BackgroundTransparency = 1, Text = label,
        TextColor3 = Color3.fromRGB(220,220,230),
        Font = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLbl = New("TextLabel", {
        Parent = row, Size = UDim2.new(0.45,0,1,0), Position = UDim2.new(0.53,0,0,0),
        BackgroundTransparency = 1, Text = tostring(Config[key]),
        TextColor3 = Color3.fromRGB(245,205,95),
        Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    row.MouseButton1Click:Connect(function()
        for i, v in ipairs(list) do
            if v == Config[key] then
                Config[key] = list[(i % #list) + 1]
                break
            end
        end
        valLbl.Text = tostring(Config[key]); Save()
    end)
    return valLbl
end

