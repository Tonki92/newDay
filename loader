--[[
    TONKI — RAW NAMECALL LOGGER
    Log MỌI namecall trong 5s. Chạy TRƯỚC khi ấn tile.
]]

local CG = game:GetService("CoreGui")
local LP = game:GetService("Players").LocalPlayer

local Log = {}
local Capture = false
local CaptureStart = 0
local CaptureDur = 8

local mt = getrawmetatable(game)
local oldNC = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    if Capture then
        local method = getnamecallmethod()
        local args = {...}
        local full = "?"
        pcall(function() full = self:GetFullName() end)
        local argStr = ""
        for _, a in ipairs(args) do
            argStr = argStr .. typeof(a) .. ":" .. tostring(a):sub(1,30) .. " "
        end
        table.insert(Log, method .. " | " .. full .. " | " .. argStr)
        if #Log > 3000 then table.remove(Log, 1) end
    end
    return oldNC(self, ...)
end)
setreadonly(mt, true)

-- Hook firesignal cũng để catch
local oldfiresignal = firesignal
if oldfiresignal then
    firesignal = function(...)
        if Capture then
            table.insert(Log, "firesignal | " .. tostring(...))
        end
        return oldfiresignal(...)
    end
end

-- GUI
