local function QuestConfirmed(name)
    local plg = LP:FindFirstChild("PlayerGui")
    if not plg then return false end
    for _, f in ipairs(plg:GetDescendants()) do
        if f:IsA("TextLabel") and f.Text:find(name) then return true end
    end
    return false
end

spawn(function()
    while task.wait(0.3) do
        pcall(function()
            if not Config.AutoFarmLevel then State.QuestTaken = false; return end
            local q, sea = FindQuest()
            if not q then return end
            State.QuestInfo = q
            local mobLv, questName = q[3], q[4]
            local qx, qy, qz = q[5], q[6], q[7]

            if not State.QuestTaken then
                TakeQuest(questName); task.wait(0.5)
                if not QuestConfirmed(questName) then
                    statusLbl.Text = "Đang chờ nhận quest..."
                    return
                end
                State.QuestTaken = true
            end

            if Dist(Vector3.new(qx, qy, qz)) > 500 then
                SetDesiredCFrame(CFrame.new(qx, qy, qz))
                task.wait(0.5)
            end

            local mobs = ScanMobs(mobLv)
            if #mobs > 0 then
                local m = mobs[1]
                State.TargetMob = m
                State.AimPos = m.hrp.CFrame
                State.AimPosRaw = m.hrp.Position
                SetDesiredCFrame(ComputeFarmCFrame(m.hrp.Position))

                RotateWeapon()  -- equip vũ khí
                task.wait(0.05)
                if Dist(m.hrp.Position) <= Config.SkillDistance + 40 then
                    ClickMob()  -- click đánh
                    UseSkills()
                    local h = Hum()
                    if h and h.Health < h.MaxHealth * Config.HealthPercent/100 then Key("R") end
                end
                statusLbl.Text = "Target: " .. m.name
                statLbl.Text = "Sea " .. sea .. " | lv " .. mobLv
            else
                statusLbl.Text = "Tìm quái lv " .. mobLv .. " (Sea " .. sea .. ")"
            end
        end)
    end
end)

