-- ============================================================================
-- BOSS TABLES
-- ============================================================================

local BossTables = {
    {name = "Smoky", level = 20, pos = CFrame.new(-2065, 99, -4686)},
    {name = "Tashi", level = 30, pos = CFrame.new(-2270, 109, -4548)},
    {name = "The Clown", level = 75, pos = CFrame.new(-397, 114, -3436)},
