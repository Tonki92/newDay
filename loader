local function DungeonEntrance()
    if game.PlaceId == 4520749081 then return CFrame.new(-4610, 33, -6009)
    elseif game.PlaceId == 6381829480 then return CFrame.new(-2428, 57, -1566)
    elseif game.PlaceId == 15759515082 then return CFrame.new(10960, 133, 1250) end
