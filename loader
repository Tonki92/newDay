function TonKi.Distance(p1, p2)
    return (p1 - p2).Magnitude
end

function TonKi.LoadSettings()
    if not isfolder(TonKi.DataFolder) then
        makefolder(TonKi.DataFolder)
    end
    local path = TonKi.DataFolder .. "/settings.json"
    if isfile(path) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if ok then
            _G.Setting = data
        end
    else
        TonKi.SaveSettings()
    end
end

function TonKi.SaveSettings()
    if not isfolder(TonKi.DataFolder) then
        makefolder(TonKi.DataFolder)
    end
    local path = TonKi.DataFolder .. "/settings.json"
    local toSave = {}
    for k, v in pairs(_G.Setting) do
        toSave[k] = v
    end
    writefile(path, HttpService:JSONEncode(toSave))
end

function TonKi.GetSetting(key)
    if _G.Setting[key] and type(_G.Setting[key]) == "table" then
        return _G.Setting[key][1]
    end
    return _G.Setting[key]
end

function TonKi.SetSetting(key, value)
    if _G.Setting[key] and type(_G.Setting[key]) == "table" then
        _G.Setting[key][1] = value
    else
        _G.Setting[key] = value
    end
end

function TonKi.Teleport(cf)
    HRP.CFrame = cf
end

function TonKi.PressKey(key, duration)
    duration = duration or 0.05
    UserInputService:SendKeyEvent(true, key, false)
    task.wait(duration)
    UserInputService:SendKeyEvent(false, key, false)
end

function TonKi.GetNearestMob(range)
    local nearest = nil
    local nearestDist = range or 300
    
    local monsterFolder = Workspace:FindFirstChild("Monster")
    if not monsterFolder then return nil end
    
    for _, entity in ipairs(monsterFolder:GetDescendants()) do
        if entity:IsA("Model") and entity:FindFirstChild("HumanoidRootPart") and entity:FindFirstChild("Humanoid") then
            if entity.Humanoid.Health > 0 then
                local dist = TonKi.Distance(HRP.Position, entity.HumanoidRootPart.Position)
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = entity
                end
            end
        end
    end
    
    return nearest
end

function TonKi.GetAllBossesOnMap()
    local bosses = {}
    local monsterFolder = Workspace:FindFirstChild("Monster")
    if not monsterFolder then return bosses end
    
    for _, entity in ipairs(monsterFolder:GetDescendants()) do
        if entity:IsA("Model") and entity:FindFirstChild("HumanoidRootPart") and entity:FindFirstChild("Humanoid") then
            if entity.Humanoid.Health > 0 then
                local name = entity.Name
                for _, boss in ipairs(BossTables) do
                    if string.find(name, boss.name) then
                        local dist = TonKi.Distance(HRP.Position, entity.HumanoidRootPart.Position)
                        table.insert(bosses, {entity = entity, name = name, dist = dist})
                        break
                    end
                end
            end
        end
    end
    
    table.sort(bosses, function(a, b) return a.dist < b.dist end)
    return bosses
end

function TonKi.GetEquippedWeapon()
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") then
            return tool.Name
        end
    end
    return nil
end

function TonKi.EquipWeapon(weaponName)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local weapon = backpack:FindFirstChild(weaponName)
        if weapon then
            weapon.Parent = Character
            task.wait(0.2)
            return true
        end
    end
    return false
end

-- ============================================================================
-- COMBAT ENGINE
-- ============================================================================

local Combat = {}

function Combat.AttackMob(mob, spamSkills)
    if not mob or not mob:FindFirstChild("HumanoidRootPart") or mob.Humanoid.Health <= 0 then
        return
    end
    
    -- Teleport near mob
    HRP.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, TonKi.GetSetting("distance"), 0)
    task.wait(0.1)
    
    -- Click spam
    for i = 1, 5 do
        if mob.Humanoid.Health <= 0 then break end
        HRP.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, TonKi.GetSetting("distance"), 0)
        task.wait(0.05)
    end
    
    -- Spam skills
    if spamSkills then
        for key, _ in pairs({z=true, x=true, c=true, v=true, f=true, b=true, e=true}) do
            if TonKi.GetSetting(key) then
                TonKi.PressKey(key)
                task.wait(0.1)
            end
            if mob.Humanoid.Health <= 0 then break end
        end
    end
end

function Combat.UseStance()
    if TonKi.GetSetting("buso") then
        TonKi.PressKey("q")
        task.wait(0.1)
    end
    if TonKi.GetSetting("ken") then
        TonKi.PressKey("w")
        task.wait(0.1)
    end
    if TonKi.GetSetting("hao") then
        TonKi.PressKey("r")
        task.wait(0.1)
    end
end

-- ============================================================================
-- AUTO FARM LOOP
-- ============================================================================

local FarmActive = false

function TonKi.StartAutoFarm()
    FarmActive = true
    spawn(function()
        while FarmActive and TonKi.GetSetting("auto_farm") do
            pcall(function()
                local mob = TonKi.GetNearestMob(TonKi.GetSetting("distancemob"))
                
                if mob and mob.Humanoid.Health > 0 then
                    Combat.UseStance()
                    Combat.AttackMob(mob, true)
                end
                
                task.wait(0.5)
            end)
        end
    end)
end

function TonKi.StopAutoFarm()
    FarmActive = false
end

-- ============================================================================
-- BOSS FARM SYSTEM
-- ============================================================================

local BossFarmActive = false

function TonKi.StartBossFarm()
    BossFarmActive = true
    spawn(function()
        while BossFarmActive and TonKi.GetSetting("allboss") do
            pcall(function()
                local bosses = TonKi.GetAllBossesOnMap()
                
                for _, bossData in ipairs(bosses) do
                    if not BossFarmActive or not TonKi.GetSetting("allboss") then break end
                    
                    local boss = bossData.entity
                    if boss.Humanoid.Health > 0 then
                        Combat.UseStance()
                        Combat.AttackMob(boss, true)
                        task.wait(1)
                    end
                end
                
                task.wait(1)
            end)
        end
    end)
end

function TonKi.StopBossFarm()
    BossFarmActive = false
end

-- ============================================================================
-- DUNGEON V2 SYSTEM (FRUIT AUTO + SWORD)
-- ============================================================================

local DungeonV2Active = false
local LastFruitUse = 0

function TonKi.StartDungeonV2()
    DungeonV2Active = true
    spawn(function()
        while DungeonV2Active and TonKi.GetSetting("dungeon2") do
            pcall(function()
                local now = tick()
                
                -- Auto fruit every 12 seconds
                if now - LastFruitUse >= 12 then
                    TonKi.PressKey("f", 0.1)
                    LastFruitUse = now
                end
                
                -- Auto sword equip
                local equipped = TonKi.GetEquippedWeapon()
                if not equipped or not string.find(equipped:lower(), "sword") then
                    local backpack = LocalPlayer:FindFirstChild("Backpack")
                    if backpack then
                        for _, tool in ipairs(backpack:GetChildren()) do
                            if tool:IsA("Tool") and (string.find(tool.Name:lower(), "sword") or string.find(tool.Name:lower(), "melee")) then
                                TonKi.EquipWeapon(tool.Name)
                                break
                            end
                        end
                    end
                end
                
                -- Attack mobs
                local mobs = {}
                local monsterFolder = Workspace:FindFirstChild("Monster")
                if monsterFolder then
                    for _, entity in ipairs(monsterFolder:GetDescendants()) do
                        if entity:IsA("Model") and entity:FindFirstChild("HumanoidRootPart") and entity:FindFirstChild("Humanoid") then
                            if entity.Humanoid.Health > 0 then
                                local dist = TonKi.Distance(HRP.Position, entity.HumanoidRootPart.Position)
                                if dist < 1000 then
                                    table.insert(mobs, {entity = entity, dist = dist})
                                end
                            end
                        end
                    end
                end
                
                table.sort(mobs, function(a, b) return a.dist < b.dist end)
                
                for i = 1, math.min(3, #mobs) do
                    if DungeonV2Active then
                        Combat.UseStance()
                        Combat.AttackMob(mobs[i].entity, true)
                        task.wait(0.5)
                    end
                end
                
                task.wait(0.3)
            end)
        end
    end)
end

function TonKi.StopDungeonV2()
    DungeonV2Active = false
end

