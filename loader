-- Build list vũ khí cần cycle
local function BuildWeaponList()
    local list = {}
    if Config.MethodMelee then
        if ToolExists("Combat") then table.insert(list, "Combat") end
    end
    if Config.MethodFruit then
        if ToolExists("Fruit Power") then table.insert(list, "Fruit Power") end
    end
    if Config.MethodSword then
        if Config.SelectedSword and ToolExists(Config.SelectedSword) then
            table.insert(list, Config.SelectedSword)
        end
    end
    -- fallback: nếu rỗng và có MethodSword bật → dùng bất kỳ tool trong backpack
    if #list == 0 and Config.MethodSword then
        local bp = LP:FindFirstChildOfClass("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then
                    table.insert(list, t.Name)
                    break
                end
            end
        end
    end
    return list
end

local function RotateWeapon(force)
    if not force and tick() - State.LastSwap < Config.WeaponSwapSpeed then return end
    State.LastSwap = tick()
    local list = BuildWeaponList()
    if #list == 0 then return end
    State.SwapIdx = (State.SwapIdx % #list) + 1
    EquipByName(list[State.SwapIdx])
end

--======================================================================
-- POSITION — giữ CFrame mỗi frame (giống code gốc) — KHÔNG PlatformStand
--======================================================================
local function SetDesiredCFrame(cf)
    State.DesiredCFrame = cf
end
local function ClearDesired()
    State.DesiredCFrame = nil
end
local function ComputeFarmCFrame(mobPos)
    local mode = Config.FarmPosMode
    if mode == "Above" then
        return CFrame.lookAt(mobPos + Vector3.new(0, Config.FarmHeight, 0), mobPos)
    elseif mode == "Underground" then
        return CFrame.lookAt(mobPos + Vector3.new(0, -Config.FarmHeight, 0), mobPos)
    elseif mode == "Behind" then
        local rad = math.rad(State.OrbitAngle)
        local off = Vector3.new(math.cos(rad), 0, math.sin(rad)) * Config.OrbitRadius
        return CFrame.lookAt(mobPos + off + Vector3.new(0, Config.FarmHeight, 0), mobPos)
    else
        return CFrame.lookAt(mobPos + Vector3.new(0, 3, 0), mobPos)
    end
end
local function AnyFarmActive()
    return Config.AutoFarmLevel or Config.AutoFarmNear or Config.AutoFarmBoss
        or Config.AutoMaterial or Config.AutoSeaEvent
        or Config.AutoDungeon or Config.AutoDungeonV2
end

