local swordListLabel = Label(TabDungeon, "dun", "Đang quét sword...")
local function refreshSwords()
    local names = {}
    local bp = LP:FindFirstChildOfClass("Backpack")
    local char = Char()
    local function scan(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and not names[tool.Name] then
                names[tool.Name] = true
                table.insert(swordListLabel and {}, tool.Name) -- noop
            end
        end
    end
    -- Build list properly
    local all = {}
    local seen = {}
    local function collect(c)
        if not c then return end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and not seen[t.Name] then
                seen[t.Name] = true
                table.insert(all, t.Name)
            end
        end
    end
    collect(bp)
    collect(char)
    return all
end

Button(TabDungeon, "dun", "Refresh Sword List", function()
    local list = refreshSwords()
    swordListLabel.Text = "Swords: " .. (#list > 0 and table.concat(list, ", ") or "none")
end)

