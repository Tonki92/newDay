            -- Quét tất cả mob trong dungeon (kể cả boss)
            local mf = workspace:FindFirstChild("MOB")
            if mf then
                local nearest, nd = nil, math.huge
                for _, m in ipairs(mf:GetChildren()) do
                    if m:IsA("Model") and not IsPlayer(m) then
                        local h = m:FindFirstChildOfClass("Humanoid")
                        local hrp = m:FindFirstChild("HumanoidRootPart")
                        if h and hrp and h.Health > 0 then
                            local d = Dist(hrp.Position)
                            if d < nd then nd, nearest = d, m end
                        end
                    end
                end
                if nearest then
                    local hrp = nearest.HumanoidRootPart
                    State.AimPos = hrp.CFrame
                    TP(hrp.CFrame * CFrame.new(0, 60, 0) * CFrame.Angles(math.rad(-90), 0, 0))
                    if Dist(hrp.Position) < 100 then
                        ClickMob()
                        UseSkills()
                    end
                end
            end
        end)
    end
end)

