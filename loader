function UISystem:AddSlider(label, key, minVal, maxVal, parent)
    local container = Instance.new("Frame")
    container.Name = label
    container.Size = UDim2.new(1, 0, 0, 50)
    container.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    container.BorderSizePixel = 0
    container.Parent = parent
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(1, -10, 0, 20)
    labelText.Position = UDim2.new(0, 5, 0, 2)
    labelText.BackgroundTransparency = 1
    labelText.TextColor3 = Color3.fromRGB(200, 200, 200)
    labelText.TextSize = 11
    labelText.Font = Enum.Font.Gotham
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.Text = label .. ": " .. TonKi.GetSetting(key)
    labelText.Parent = container
    
    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, -10, 0, 5)
    sliderBg.Position = UDim2.new(0, 5, 0, 25)
    sliderBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = container
    
    local sliderFill = Instance.new("Frame")
    sliderFill.BackgroundColor3 = Color3.fromRGB(200, 100, 180)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBg
    
    local function updateSlider()
        local ratio = (TonKi.GetSetting(key) - minVal) / (maxVal - minVal)
        sliderFill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
        labelText.Text = label .. ": " .. TonKi.GetSetting(key)
    end
    updateSlider()
    
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mouse = LocalPlayer:GetMouse()
            local dragging = true
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
            while dragging do
                local ratio = math.clamp((mouse.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                TonKi.SetSetting(key, math.floor(minVal + (maxVal - minVal) * ratio))
                updateSlider()
                task.wait()
            end
        end
    end)
end

