mkBtn("SCAN TILE CLICK CONNECTIONS", -72, function()
    local plg = LP:FindFirstChild("PlayerGui")
    local mg = plg and plg:FindFirstChild("MainGui")
    if not mg then addLog("[Scan] không có MainGui"); return end
    local cnt = 0
    for _, g in ipairs(mg:GetDescendants()) do
        if g:IsA("ImageButton") or g:IsA("TextButton") then
            local totalConns = 0
            for _, sig in ipairs({"MouseButton1Click","MouseButton1Down","MouseButton1Up","Activated","InputBegan","InputEnded","TouchTap","TouchLongPress"}) do
                local ok, conns = pcall(getconnections, g[sig])
                if ok and conns then totalConns = totalConns + #conns end
            end
            if totalConns > 0 then
                cnt = cnt + 1
                addLog(("[Btn] %s totalConns=%d"):format(g.Name, totalConns))
            end
        end
    end
    addLog("[Scan] " .. cnt .. " button có connection")
end)

mkBtn("SCAN REMOTE.Skill_Effect LISTENERS", -72, function()
    local rs = game:GetService("ReplicatedStorage")
    local ev = rs:FindFirstChild("Chest")
    ev = ev and ev:FindFirstChild("Remotes")
    ev = ev and ev:FindFirstChild("Events")
    ev = ev and ev:FindFirstChild("Skill_Effect")
    if not ev then addLog("[Scan] không có Skill_Effect"); return end
    local ok, conns = pcall(getconnections, ev.OnClientEvent)
    if ok and conns then
        addLog("[Skill_Effect] OnClientEvent listeners: " .. #conns)
        for i, c in ipairs(conns) do
            addLog("  [" .. i .. "] " .. tostring(c.Function))
        end
    else
        addLog("[Skill_Effect] không đọc được connections")
    end
end, true)

