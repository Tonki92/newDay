-- CLICK / SKILLS — giống code gốc: duyệt TẤT CẢ tool đang cầm, invoke cả FS/SW/DF
--======================================================================
local function ClickMob()
    local c = Char()
    if not c then return end
    local hit = State.AimPos or (HRP() and HRP().CFrame)
    if not hit then return end
    for _, tool in ipairs(c:GetChildren()) do
        if tool:IsA("Tool") then
            for _, prefix in ipairs({"FS_","SW_","DF_","GH_"}) do
                pcall(function()
                    RS.Chest.Remotes.Functions.SkillAction:InvokeServer(
                        prefix .. tool.Name .. "_M1",
                        {MouseHit = hit, Type = "Up"}
                    )
                end)
            end
        end
    end
end

