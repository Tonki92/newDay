local function Lv()
    local ps = LP:FindFirstChild("PlayerStats")
    return (ps and ps:FindFirstChild("lvl")) and ps.lvl.Value or 1
end
local function FindQuest()
    local l = Lv()
    local tbl = QUEST_TABLE[GetSea()] or QUEST_TABLE[1]
    for _,q in ipairs(tbl) do
        if l >= q[1] and l <= q[2] then return q, GetSea() end
    end
end
local function TakeQuest(n)
    pcall(function()
        RS.Chest.Remotes.Functions.Quest:InvokeServer("take", n)
    end)
end

