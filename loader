    New("TextLabel", {
        Parent = row, Size = UDim2.new(0.5,0,1,0), Position = UDim2.new(0,12,0,0),
        BackgroundTransparency = 1, Text = label,
        TextColor3 = Color3.fromRGB(220,220,230),
        Font = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLbl = New("TextLabel", {
        Parent = row, Size = UDim2.new(0.4,0,1,0), Position = UDim2.new(0.55,0,0,0),
        BackgroundTransparency = 1, Text = tostring(Config[key]),
        TextColor3 = Color3.fromRGB(245,205,95),
        Font = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    row.MouseButton1Click:Connect(function()
        for i, v in ipairs(list) do
            if v == Config[key] then
                Config[key] = list[(i % #list) + 1]
                break
            end
        end
        valLbl.Text = tostring(Config[key])
        Save()
    end)
    return valLbl
end

