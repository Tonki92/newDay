-- COMBAT LOOP (giống code gốc: click + autoskill liên tục)
--=========================
spawn(function()
    while task.wait() do
        pcall(function()
            if not State.AimPos then return end
            if not (Config.AutoFarmLevel or Config.AutoFarmNear or Config.AutoFarmBoss
                or Config.AutoMaterial or Config.AutoSeaEvent
                or Config.AutoDungeon or Config.AutoDungeonV2) then return end
            click()
            if State.AimPosRaw and Dist(State.AimPosRaw) < 400 then
                autoskill()
                local h = Hum()
                if h and h.Health < h.MaxHealth * Config.HealthPercent/100 then Key("R") end
            end
        end)
    end
end)

--=========================
-- TOOL EQUIP LOOP
--=========================
spawn(function()
    while task.wait() do
        pcall(function()
            if not (Config.AutoFarmLevel or Config.AutoFarmNear or Config.AutoFarmBoss
                or Config.AutoMaterial or Config.AutoSeaEvent
                or Config.AutoDungeon or Config.AutoDungeonV2) then return end
            local list = BuildWeaponList()
            if #list == 0 then
                -- Fallback: equip bất kỳ tool nào
                local bp = LP:FindFirstChildOfClass("Backpack")
                if bp then
                    for _, t in ipairs(bp:GetChildren()) do
                        if t:IsA("Tool") then
                            pcall(function() Hum():EquipTool(t) end)
                            break
                        end
                    end
                end
                return
            end
            State.SwapIdx = (State.SwapIdx % #list) + 1
            local pick = list[State.SwapIdx]
            EquipAny(pick)
            task.wait(Config.WeaponSwapSpeed)
        end)
    end
end)

