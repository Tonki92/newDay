--======================================================================
local function EquipByTooltip(tip)
    local bp = LP:FindFirstChildOfClass("Backpack")
    if not bp then return false end
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and t.ToolTip == tip then
            pcall(function() Hum():EquipTool(t) end)
            return true
        end
    end
    -- đã cầm rồi
    local c = Char()
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == tip then return true end
        end
    end
    return false
end

local function EquipAny(identifier)
    if not identifier then return false end
    -- Ưu tiên ToolTip (Combat / Sword / Fruit Power)
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (t.ToolTip == identifier or t.Name == identifier) then
                pcall(function() Hum():EquipTool(t) end)
                return true
            end
        end
    end
    -- Đã cầm rồi
    local c = Char()
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and (t.ToolTip == identifier or t.Name == identifier) then return true end
        end
    end
    return false
end

local function ToolExists(identifier)
    if not identifier then return false end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (t.ToolTip == identifier or t.Name == identifier) then return true end
        end
    end
    local c = Char()
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and (t.ToolTip == identifier or t.Name == identifier) then return true end
        end
    end
    return false
end

local function BuildWeaponList()
    local list = {}
    if Config.MethodMelee and ToolExists("Combat") then table.insert(list, "Combat") end
    if Config.MethodFruit and ToolExists("Fruit Power") then table.insert(list, "Fruit Power") end
    if Config.MethodSword and Config.SelectedSword and ToolExists(Config.SelectedSword) then
        table.insert(list, Config.SelectedSword)
    end
    return list
end

