local function SliderInput(parent, label, key, min, max, decimals)
    local row = New("Frame", {Parent = parent, Size = UDim2.new(1,-2,0,44),
        BackgroundColor3 = Color3.fromRGB(20,20,26),
        BackgroundTransparency = math.min(0.9, Config.MenuTransparency),
        BorderSizePixel = 0})
    Corner(row, 5)
    New("TextLabel", {Parent = row, Size = UDim2.new(0.6,0,0,16), Position = UDim2.new(0,10,0,3),
        BackgroundTransparency = 1, Text = label, TextColor3 = Color3.fromRGB(220,220,230),
        Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left})
    local box = New("TextBox", {Parent = row, Size = UDim2.new(0,58,0,18),
        Position = UDim2.new(1,-66,0,2), BackgroundColor3 = Color3.fromRGB(12,12,16),
        Text = tostring(Config[key]), TextColor3 = Color3.fromRGB(245,205,95),
        Font = Enum.Font.GothamBold, TextSize = 11, ClearTextOnFocus = false})
    Corner(box, 4)
    Stroke(box, Color3.fromRGB(60,60,70), 1)
    local bar = New("Frame", {Parent = row, Size = UDim2.new(1,-20,0,6), Position = UDim2.new(0,10,0,26),
        BackgroundColor3 = Color3.fromRGB(45,45,55), BorderSizePixel = 0})
    Corner(bar, 3)
    local fill = New("Frame", {Parent = bar, Size = UDim2.new((Config[key]-min)/(max-min),0,1,0),
        BackgroundColor3 = Color3.fromRGB(245,205,95), BorderSizePixel = 0})
    Corner(fill, 3)
    local function Apply(val, ub)
        val = math.clamp(val, min, max)
        if decimals then val = math.floor(val*10^decimals)/10^decimals
        else val = math.floor(val) end
        Config[key] = val
        if ub then box.Text = tostring(val) end
        fill.Size = UDim2.new((val-min)/(max-min),0,1,0)
        Save()
    end
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then Apply(n, true) else box.Text = tostring(Config[key]) end
    end)
    local dragging = false
    local function UfromX(x)
        local abs, w = bar.AbsolutePosition.X, bar.AbsoluteSize.X
        if w <= 0 then return end
        Apply(min + math.clamp((x-abs)/w,0,1)*(max-min), true)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then dragging = true; UfromX(i.Position.X) end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then UfromX(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

