local function addLog(t)
    local l = Instance.new("TextLabel", logBox)
    l.Size = UDim2.new(1, -6, 0, 14)
    l.BackgroundTransparency = 1
    l.Text = t
    l.TextColor3 = Color3.fromRGB(210, 210, 210)
    l.Font = Enum.Font.Code
    l.TextSize = 10
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextWrapped = true
    logBox.CanvasPosition = Vector2.new(0, 1e6)
end

local function mkBtn(text, y, cb)
    local b = Instance.new("TextButton", panel)
    b.Size = UDim2.new(1, -20, 0, 26)
    b.Position = UDim2.new(0, 10, 1, y)
    b.BackgroundColor3 = Color3.fromRGB(30, 26, 12)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(245, 205, 95)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 11
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
    b.MouseButton1Click:Connect(function() if cb then pcall(cb) end end)
    return b
end

mkBtn("TOGGLE TRACE", -92, function()
    TraceOn = not TraceOn
    addLog("[Trace] " .. (TraceOn and "ON" or "OFF"))
end)

mkBtn("DUMP + COPY", -62, function()
    local out = {}
    for _, e in ipairs(TraceLog) do
        local s = e.method .. " → " .. e.full .. "  [ "
        for _, a in ipairs(e.args) do
            s = s .. typeof(a) .. ":" .. tostring(a) .. " "
        end
        s = s .. "]"
        table.insert(out, s)
    end
    local txt = table.concat(out, "\n")
    if setclipboard then pcall(function() setclipboard(txt) end) end
    if writefile then pcall(function() writefile("TonKi_PuzzleLog.txt", txt) end) end
    addLog("[Dump] " .. #out .. " entries copied")
end)

mkBtn("SCAN GUI MỚI XUẤT HIỆN", -32, function()
    local plg = LP:FindFirstChild("PlayerGui")
    if not plg then return end
    for _, g in ipairs(plg:GetChildren()) do
        if g:IsA("ScreenGui") and not KnownGuis[g] and g.Enabled then
            KnownGuis[g] = true
            local imgbtn, textbtn = 0, 0
            for _, c in ipairs(g:GetDescendants()) do
                if c:IsA("ImageButton") then imgbtn = imgbtn + 1 end
                if c:IsA("TextButton") then textbtn = textbtn + 1 end
            end
            addLog(("[GUI] %s Img=%d Txt=%d"):format(g.Name, imgbtn, textbtn))
        end
    end
end)

mkBtn("CLOSE", -2, function() gui:Destroy() end)

-- Auto scan mỗi 1s
spawn(function()
    while gui.Parent do
        task.wait(1)
        local plg = LP:FindFirstChild("PlayerGui")
        if plg then
            for _, g in ipairs(plg:GetChildren()) do
                if g:IsA("ScreenGui") and not KnownGuis[g] and g.Enabled then
                    KnownGuis[g] = true
                    local imgbtn = 0
                    for _, c in ipairs(g:GetDescendants()) do
                        if c:IsA("ImageButton") then imgbtn = imgbtn + 1 end
                    end
                    if imgbtn >= 12 then
                        addLog(("[PUZZLE?] %s  Img=%d"):format(g.Name, imgbtn))
                    end
                end
            end
        end
    end
end)

-- Auto log trace
spawn(function()
    local last = 0
    while gui.Parent do
        task.wait(0.3)
        if #TraceLog > last then
            for i = last + 1, #TraceLog do
                local e = TraceLog[i]
                local argS = ""
                for _, a in ipairs(e.args) do
                    argS = argS .. tostring(a) .. " "
                end
                addLog(e.remote .. "  [" .. argS .. "]")
            end
            last = #TraceLog
        end
    end
end)

pcall(function()
    SG:SetCore("SendNotification", {Title="TonKi", Text="Detector chạy. Nhận quest sea beast rồi ấn tile.", Duration=4})
end)

return TraceLog
