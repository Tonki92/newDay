--[[
    ╔══════════════════════════════════════════════════════════╗
    ║         TONKI HUB — PLAY BUTTON DIAGNOSTIC v1.0          ║
    ║  Chạy ở loading screen, đợi Play xuất hiện, dump tất cả  ║
    ╚══════════════════════════════════════════════════════════╝

    HƯỚNG DẪN:
    1. Executor (Delta/Scriptware/etc) → paste script này → Execute
    2. Vào game King Legacy (loading screen hiện Play)
    3. Đợi 3-5s cho script dump
    4. Mở console (F9) hoặc xem clipboard, copy toàn bộ kết quả gửi mình
]]

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local SG      = game:GetService("StarterGui")
local LP      = Players.LocalPlayer

local OUT = {}

local function log(s)
    table.insert(OUT, s)
    print(s)
end

local function sep(t)
    log("\n══════════ " .. t .. " ══════════")
end

local function safe(fn, ...)
    local ok, res = pcall(fn, ...)
    if ok then return res end
    return "[ERR: " .. tostring(res) .. "]"
end

--======================================================================
-- Đợi Play button
--======================================================================
local playBtn = nil
local playGui = nil
local elapsed = 0

log("TonKi Hub Diagnostic started...")
log("Đang tìm nút Play trong PlayerGui...")

while elapsed < 30 do
    local plg = LP:FindFirstChild("PlayerGui")
    if plg then
        -- Tìm theo LoadingGUI/Play trước
        local loading = plg:FindFirstChild("LoadingGUI")
        if loading then
            local p = loading:FindFirstChild("Play")
            if p and p:IsA("TextButton") and p.Visible then
                playBtn = p
                playGui = loading
                break
            end
        end
        -- Fallback: quét toàn bộ
        for _, g in ipairs(plg:GetDescendants()) do
            if g:IsA("TextButton") and g.Visible then
                local t = g.Text:lower():gsub("%s","")
                if t == "play" then
                    playBtn = g
                    playGui = g.Parent
                    break
                end
            end
        end
        if playBtn then break end
    end
    task.wait(0.2)
    elapsed = elapsed + 0.2
end

if not playBtn then
    log("[X] Không tìm thấy nút Play sau 30s. Chạy lại ở loading screen.")
    if setclipboard then setclipboard(table.concat(OUT, "\n")) end
    return
end

log("[✓] Đã tìm thấy Play button!")

--======================================================================
-- 1. Thông tin cơ bản button
--======================================================================
sep("BUTTON INFO")
log("ClassName      : " .. playBtn.ClassName)
log("Name           : " .. playBtn.Name)
log("FullName       : " .. playBtn:GetFullName())
log("Text           : " .. tostring(playBtn.Text))
log("Visible        : " .. tostring(playBtn.Visible))
log("Active         : " .. tostring(playBtn.Active))
log("AutoButtonColor: " .. tostring(playBtn.AutoButtonColor))
log("Position       : " .. tostring(playBtn.Position))
log("Size           : " .. tostring(playBtn.Size))
log("TextColor3     : " .. tostring(playBtn.TextColor3))

--======================================================================
-- 2. Hierarchy (ancestors)
--======================================================================
sep("HIERARCHY")
local anc = playBtn
local depth = 0
while anc and depth < 10 do
    log(string.rep("  ", depth) .. "└─ " .. anc.ClassName .. " : " .. anc.Name)
    anc = anc.Parent
    depth = depth + 1
    if anc == game then break end
end

--======================================================================
-- 3. Siblings trong parent
--======================================================================
sep("SIBLINGS")
if playBtn.Parent then
    log("Parent: " .. playBtn.Parent:GetFullName())
    for _, child in ipairs(playBtn.Parent:GetChildren()) do
        log("  • " .. child.ClassName .. " | " .. child.Name ..
            (child == playBtn and "  ← PLAY" or ""))
    end
end

--======================================================================
-- 4. Connections — fire signals
--======================================================================
sep("CONNECTIONS ON PLAY BUTTON")
for _, sig in ipairs({
    "MouseButton1Click","MouseButton1Down","MouseButton1Up",
    "Activated","TouchTap","InputBegan","InputEnded","InputChanged"
}) do
    local ok, conns = pcall(getconnections, playBtn[sig])
    if ok and conns then
        log(sig .. " → " .. #conns .. " connection(s)")
        for i, c in ipairs(conns) do
            log("   [" .. i .. "]")
            log("      Function : " .. tostring(c.Function))
            log("      State    : " .. tostring(c.State))
            log("      Thread   : " .. tostring(c.Thread))

            -- Upvalues của function
            local fn = c.Function
            if fn then
                for j = 1, 20 do
                    local ok2, uv = pcall(getupvalue, fn, j)
                    if not ok2 or uv == nil then break end
                    local uvType = typeof(uv)
                    local uvVal = tostring(uv)
                    if uvType == "table" or uvType == "userdata" then
                        uvVal = uvVal .. " ["
                        if uv.Name then uvVal = uvVal .. "Name=" .. tostring(uv.Name) end
                        if uv.ClassName then uvVal = uvVal .. " Class=" .. tostring(uv.ClassName) end
                        if uv.GetFullName then
                            local ok3, full = pcall(function() return uv:GetFullName() end)
                            if ok3 then uvVal = uvVal .. " Full=" .. full end
                        end
                        uvVal = uvVal .. "]"
                    elseif uvType == "function" then
                        uvVal = "[function] " .. tostring(uv)
                    end
                    log("      UV[" .. j .. "] : " .. uvType .. " = " .. uvVal)
                end
            end
        end
    end
end

--======================================================================
-- 5. Quét các RemoteEvent/RemoteFunction gần đó (Ancestors)
--======================================================================
sep("REMOTES IN ANCESTORS")
local scanRoot = playBtn
for _ = 1, 3 do
    if scanRoot.Parent then scanRoot = scanRoot.Parent end
end
log("Scanning: " .. scanRoot:GetFullName())
local remotesFound = 0
for _, obj in ipairs(scanRoot:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")
    or obj:IsA("BindableEvent") or obj:IsA("BindableFunction") then
        log("  • " .. obj.ClassName .. " : " .. obj:GetFullName())
        remotesFound = remotesFound + 1
    end
end
log("Total remotes in ancestors: " .. remotesFound)

--======================================================================
-- 6. Quét toàn bộ ReplicatedStorage remotes có tên đáng ngờ
--======================================================================
sep("LIKELY PLAY REMOTES IN REPLICATEDSTORAGE")
local keywords = {"play","load","spawn","ready","enter","start","begin","join","game","click"}
local hit = 0
for _, obj in ipairs(RS:GetDescendants()) do
    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        local n = obj.Name:lower()
        for _, kw in ipairs(keywords) do
            if n:find(kw) then
                log("  → " .. obj.ClassName .. " : " .. obj:GetFullName())
                hit = hit + 1
                break
            end
        end
    end
end
log("Total hits: " .. hit)

--======================================================================
-- 7. Quét PlayerScripts — tìm ModuleScript có chữ "Play"/"Load"
--======================================================================
sep("PLAYERSCRIPTS — MODULES LIÊN QUAN")
local ps = LP:FindFirstChild("PlayerScripts")
if ps then
    for _, obj in ipairs(ps:GetDescendants()) do
        if obj:IsA("ModuleScript") or obj:IsA("LocalScript") then
            local n = obj.Name:lower()
            for _, kw in ipairs(keywords) do
                if n:find(kw) then
                    log("  • " .. obj.ClassName .. " : " .. obj:GetFullName())
                    break
                end
            end
        end
    end
end

--======================================================================
-- 8. PlayerGui full tree (top 3 levels)
--======================================================================
sep("PLAYERGUI TOP-LEVEL")
local plg = LP:FindFirstChild("PlayerGui")
if plg then
    for _, child in ipairs(plg:GetChildren()) do
        log("  • " .. child.ClassName .. " : " .. child.Name ..
            " (Visible=" .. tostring(child.Visible) .. ")")
    end
end

--======================================================================
-- KẾT THÚC — in và copy
--======================================================================
sep("END")
log("Diagnostic complete. Copy và gửi cho TonKi Hub dev.")

local result = table.concat(OUT, "\n")

-- Copy vào clipboard nếu executor hỗ trợ
if setclipboard then
    pcall(function() setclipboard(result) end)
    print("\n[✓] Đã copy kết quả vào clipboard!")
end

-- Ghi ra file nếu có writefile
if writefile then
    pcall(function()
        local fname = "TonKiHub_PlayDump.txt"
        writefile(fname, result)
        print("[✓] Đã lưu vào file: " .. fname)
    end)
end

-- Notify
pcall(function()
    SG:SetCore("SendNotification", {
        Title = "TonKi Hub",
        Text = "Dump xong! Copy clipboard hoặc xem file TonKiHub_PlayDump.txt",
        Duration = 5
    })
end)

return result
