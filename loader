--======================================================================
-- TOOL EQUIP — dùng cả Name và ToolTip như code gốc
--======================================================================
local function FindToolAnywhere(name)
    if not name then return nil end
    local c = Char()
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and (t.Name == name or t.ToolTip == name) then return t end
        end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (t.Name == name or t.ToolTip == name) then return t end
        end
    end
    return nil
end

local function ToolExists(name)
    return FindToolAnywhere(name) ~= nil
end

-- Equip theo name hoặc tooltip
local function EquipByName(name)
    if not name then return false end
    local c = Char()
    if not c then return false end
    -- Đang cầm rồi?
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and (t.Name == name or t.ToolTip == name) then
            return true
        end
    end
    local tool = FindToolAnywhere(name)
    if tool then
        pcall(function() Hum():EquipTool(tool) end)
        return true
    end
    return false
end

local function CurrentTool()
    local c = Char()
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then return t end
    end
end

