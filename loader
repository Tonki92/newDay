                    ClickMob(); UseSkills()
                end
                statLbl.Text = "Dungeon: " .. nearest.Name
            end
        end)
    end
end)

-- AUTO DUNGEON V2: fruit Z có CD + scan all + sword
spawn(function()
    while task.wait(0.5) do
        pcall(function()
            if not Config.AutoDungeonV2 then return end
            local plg = LP:FindFirstChild("PlayerGui")
            if not (plg and plg:FindFirstChild("DungeonUI")) then
                State.InRaid = false
                return
            end
            State.InRaid = true

            if Config.SelectedSword then EquipByName(Config.SelectedSword) end

            if tick() - State.LastFruitZ >= Config.FruitCD then
                Key("Z")
                State.LastFruitZ = tick()
            end

            local mf = workspace:FindFirstChild("MOB")
            if not mf then return end
            local nearest, nd
            for _, m in ipairs(mf:GetChildren()) do
                if m:IsA("Model") and not IsPlayer(m) then
                    local h = m:FindFirstChildOfClass("Humanoid")
                    local hrp = m:FindFirstChild("HumanoidRootPart")
                    if h and hrp and h.Health > 0 then
                        local d = Dist(hrp.Position)
                        if not nd or d < nd then nd, nearest = d, m end
                    end
                end
            end
            if nearest then
                local hrp = nearest.HumanoidRootPart
                State.AimPos = hrp.CFrame
                TP(ComputeFarmCFrame(hrp.Position))
                if Dist(hrp.Position) < 150 then
                    ClickMob()
                    UseSkills()
                    if Hum() and Hum().Health < Hum().MaxHealth * Config.HealthPercent/100 then
                        Key("R")
                    end
                end
            end
        end)
    end
end)

