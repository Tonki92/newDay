local function SliderInput(parent, label, key, min, max, decimals)
    local row = New("Frame", {
        Parent = parent, Size = UDim2.new(1,-4,0,52),
        BackgroundColor3 = Color3.fromRGB(20,20,26),
        BackgroundTransparency = 0.1, BorderSizePixel = 0,
    })
    Corner(row, 6)
    New("TextLabel", {
        Parent = row, Size = UDim2.new(0.6,0,0,20), Position = UDim2.new(0,12,0,4),
        BackgroundTransparency = 1, Text = label,
        TextColor3 = Color3.fromRGB(220,220,230),
        Font = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local box = New("TextBox", {
        Parent = row, Size = UDim2.new(0,70,0,20),
        Position = UDim2.new(1,-82,0,4),
        BackgroundColor3 = Color3.fromRGB(12,12,16),
        Text = tostring(Config[key]),
        TextColor3 = Color3.fromRGB(245,205,95),
        Font = Enum.Font.GothamBold, TextSize = 12,
        ClearTextOnFocus = false,
    })
    Corner(box, 4)
    Stroke(box, Color3.fromRGB(60,60,70), 1)

    local bar = New("Frame", {
        Parent = row, Size = UDim2.new(1,-24,0,8),
        Position = UDim2.new(0,12,0,32),
        BackgroundColor3 = Color3.fromRGB(45,45,55),
        BorderSizePixel = 0,
    })
    Corner(bar, 4)
    local fill = New("Frame", {
        Parent = bar, Size = UDim2.new((Config[key]-min)/(max-min),0,1,0),
        BackgroundColor3 = Color3.fromRGB(245,205,95), BorderSizePixel = 0,
    })
    Corner(fill, 4)

    local function Apply(val, updateBox)
        val = math.clamp(val, min, max)
        if decimals then
            local m = 10^decimals
            val = math.floor(val*m)/m
        else
            val = math.floor(val)
        end
        Config[key] = val
        if updateBox then box.Text = tostring(val) end
        fill.Size = UDim2.new((val-min)/(max-min),0,1,0)
        Save()
    end
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then Apply(n, true) else box.Text = tostring(Config[key]) end
    end)

    local dragging = false
    local function UpdateFromX(x)
        local abs, w = bar.AbsolutePosition.X, bar.AbsoluteSize.X
        local pct = math.clamp((x-abs)/w, 0, 1)
        Apply(min + pct*(max-min), true)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateFromX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromX(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

