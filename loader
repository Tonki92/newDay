local function Cycler(parent, label, key, list)
    local row = New("TextButton", {
        Parent = parent, Size = UDim2.new(1,-4,0,32),
        BackgroundColor3 = Color3.fromRGB(20,20,26),
        BackgroundTransparency = 0.1, Text = "", AutoButtonColor = false,
    })
