--======================================================================
-- SCAN MOBS / BOSSES (KHÔNG QUÉT PLAYER)
--======================================================================
local function parseLevel(name)
    local lv = name:match("Lv%.%s*(%d+)")
    return tonumber(lv)
end

local function ScanMobs(filterLevel)
    local list = {}
    local mf = workspace:FindFirstChild("Monster")
    if not mf then return list end
    for _, folder in ipairs(mf:GetChildren()) do
        if folder:IsA("Folder") and not IsPlayer(folder) then
            for _, mob in ipairs(folder:GetChildren()) do
                if mob:IsA("Model") and not IsPlayer(mob) then
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    local hrp = mob:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health > 0 then
                        local lv = parseLevel(mob.Name)
                        if lv and (not filterLevel or lv == filterLevel) then
                            table.insert(list, {
                                model = mob, hrp = hrp, hum = hum,
                                level = lv, name = mob.Name,
                                dist = Dist(hrp.Position)
                            })
                        end
                    end
                end
            end
        end
    end
    table.sort(list, function(a,b) return a.dist < b.dist end)
    return list
end

local function ScanBosses()
    -- Quét toàn bộ folder Monster, chỉ lấy mob có tên là boss
    local list = {}
    local mf = workspace:FindFirstChild("Monster")
    if not mf then return list end
    local BOSS_KEYWORDS = {
        "Smoky","Tashi","Clown","Captain","Barbaric","Karate Fishman","Shark Man",
        "Dark Leg","King Snow","Little Dear","Bomb Man","King of Sand","Ball Man",
        "Rumble Man","Leader","Pasta","Wolf","Giraffe","Leo","Shadow Master",
        "True Karate Fishman","Quake Woman","Combat Fishman","Sword Fishman",
        "Seasoned Fishman","Gazelle","Violet Samurai","Duke","Magician","Kitsune",
        "Bear Man","Bean","Meji","Petra","Kappa","Joey","Elite Skeleton",
        "Desert Thief","Anubis","Pharaoh","Sunken Vessel","Biscuit Man","Dough Master",
        "Supreme Swordman","Sally","Pondere","Hefty","Lomeo","Prince Aria","Devastate",
        "Floffy","Ryu","Fugitive","Deep One","Cyborg Gorilla","Ripcurrent","Tidal",
        "Ocean Gladiator","Electro Abyss","Inferno Diver","Tempest","Abyssal",
        "Prisoner of Gravity",
    }
    for _, folder in ipairs(mf:GetChildren()) do
        if folder:IsA("Folder") and not IsPlayer(folder) then
            for _, mob in ipairs(folder:GetChildren()) do
                if mob:IsA("Model") and not IsPlayer(mob) then
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    local hrp = mob:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health > 0 then
                        for _, kw in ipairs(BOSS_KEYWORDS) do
                            if mob.Name:find(kw) then
                                table.insert(list, {
                                    model = mob, hrp = hrp, hum = hum,
                                    level = parseLevel(mob.Name) or 0,
                                    name = mob.Name,
                                    dist = Dist(hrp.Position)
                                })
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(list, function(a,b) return a.dist < b.dist end)
    return list
end

