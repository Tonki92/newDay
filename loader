--[[
    TONKI — HOOK TEST v3
    Dùng hookmetamethod (Delta/Scriptware) + fallback.
    Có self-test để verify hook hoạt động.
]]

local CG = game:GetService("CoreGui")
local SG = game:GetService("StarterGui")
local LP = game:GetService("Players").LocalPlayer

local Log = {}
local HookOK = false
local Capture = false

local function addLog(t)
    table.insert(Log, t)
    if #Log > 800 then table.remove(Log, 1) end
    print("[TonKi]", t)
end

--======================================================================
-- HOOK NAME CALL — thử nhiều API
--======================================================================
local hooked = false

-- Cách 1: hookmetamethod (Delta / Scriptware / Codex)
pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if Capture and (method == "FireServer" or method == "InvokeServer") then
            local args = {...}
            local full = "?"
            pcall(function() full = self:GetFullName() end)
            local argStr = ""
            for _, a in ipairs(args) do
                argStr = argStr .. typeof(a) .. ":" .. tostring(a):sub(1,25) .. " "
            end
            addLog("NC| " .. full .. " | " .. argStr)
        end
        return oldNamecall(self, ...)
    end))
    hooked = true
    addLog("[Hook] hookmetamethod OK")
end)

-- Cách 2: fallback setrawmetatable
if not hooked then
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNC = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if Capture and (method == "FireServer" or method == "InvokeServer") then
                local args = {...}
                local full = "?"
                pcall(function() full = self:GetFullName() end)
                local argStr = ""
                for _, a in ipairs(args) do
                    argStr = argStr .. typeof(a) .. ":" .. tostring(a):sub(1,25) .. " "
                end
                addLog("NC| " .. full .. " | " .. argStr)
            end
            return oldNC(self, ...)
        end)
        setreadonly(mt, true)
        hooked = true
        addLog("[Hook] setrawmetatable OK")
    end)
end

if not hooked then
    addLog("[Hook] FAILED — executor không hỗ trợ")
end

