local function FireAllClicks(gui)
    for _, sig in ipairs({"MouseButton1Up","MouseButton1Down","MouseButton1Click","Activated"}) do
        local ok, conns = pcall(getconnections, gui[sig])
        if ok then for _, c in ipairs(conns) do pcall(function() c:Fire() end) end end
    end
end
local function TryEnterDungeon()
    local plg = LP:FindFirstChild("PlayerGui")
    if not plg or not plg:FindFirstChild("ChooseMap") then return end
    local mapFrame = plg.ChooseMap:FindFirstChild("ChooseMapFrame")
    if not mapFrame then return end
    local mf = mapFrame:FindFirstChild("MapFrame")
    if not mf then return end
    local mode = mf:FindFirstChild(Config.DungeonMode)
    if mode then FireAllClicks(mode); task.wait(0.3) end
    for _, gui in ipairs(plg:GetDescendants()) do
        if gui:IsA("TextButton") and (gui.Text:lower():find("play") or gui.Text:lower():find("start")) then
            FireAllClicks(gui)
        end
    end
end

--======================================================================
-- AIMBOT HOOK
--======================================================================
pcall(function()
    local mt = getrawmetatable(game)
    local oldNC = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local args = {...}
        if getnamecallmethod() == "InvokeServer" and tostring(self) == "SkillAction" then
            if State.AimPos and (Config.AutoAim or State.AimPos) then
                if typeof(args[2]) == "table" and args[2].Type == "Up" then
                    args[2].MouseHit = State.AimPos
                end
            end
        end
        return oldNC(self, unpack(args))
    end)
    setreadonly(mt, true)
end)

