-- HAKI — cooldown 3s, tránh spam
--======================================================================
local function UseBuso()
    if tick() - State.HakiLastFire < 3 then return end
    if State.HakiBusy then return end
    State.HakiBusy = true
    pcall(function()
        local pchar = workspace:FindFirstChild("PlayerCharacters")
        if not pchar then return end
        local me = pchar:FindFirstChild(LP.Name)
        if not me then return end
        local svc = me:FindFirstChild("Services")
        if not svc then return end
        local haki = svc:FindFirstChild("Haki")
        if haki and haki.Value == 0 then
            RS.Chest.Remotes.Events.Armament:FireServer()
            State.HakiLastFire = tick()
        end
    end)
    task.wait(0.2)
    State.HakiBusy = false
end
local function UseKen()
    if tick() - (State.KenLastFire or 0) < 3 then return end
    pcall(function()
        local svc = workspace.PlayerCharacters[LP.Name].Services
        if svc.KenOpen.Value == false then
            RS.Chest.Remotes.Functions.KenEvent:InvokeServer()
            State.KenLastFire = tick()
        end
    end)
end

