--[[
    TONKI HUB — PLAY DUMP GUI v1.0
    Chạy script này ở loading screen, xem kết quả trên GUI trong game.
    Không cần console.
]]

local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local CG      = game:GetService("CoreGui")
local LP      = Players.LocalPlayer

local OUT = {}
local function log(s) table.insert(OUT, s) print(s) end

-- Tìm Play button
local playBtn
local t = 0
while t < 30 do
    local plg = LP:FindFirstChild("PlayerGui")
    if plg then
        local lg = plg:FindFirstChild("LoadingGUI")
        if lg then
            local p = lg:FindFirstChild("Play")
            if p and p:IsA("TextButton") and p.Visible then playBtn = p break end
        end
        for _, g in ipairs(plg:GetDescendants()) do
            if g:IsA("TextButton") and g.Visible and g.Text:lower():gsub("%s","") == "play" then
                playBtn = g break
            end
        end
        if playBtn then break end
    end
    task.wait(0.2); t = t + 0.2
end

if not playBtn then
    log("[X] Không tìm thấy nút Play. Chạy lại ở loading screen.")
else
    log("=== BUTTON ===")
    log("Class: " .. playBtn.ClassName)
    log("Name : " .. playBtn.Name)
    log("Full : " .. playBtn:GetFullName())
    log("Text : " .. tostring(playBtn.Text))

    log("\n=== HIERARCHY ===")
    local a, d = playBtn, 0
    while a and d < 10 do
        log(string.rep("  ", d) .. "└ " .. a.ClassName .. " : " .. a.Name)
        a = a.Parent; d = d + 1
        if a == game then break end
    end

    log("\n=== CONNECTIONS ===")
    for _, sig in ipairs({"MouseButton1Click","MouseButton1Down","Activated","TouchTap"}) do
        local ok, conns = pcall(getconnections, playBtn[sig])
        if ok and conns then
            log(sig .. " -> " .. #conns)
            for i, c in ipairs(conns) do
                log("  [" .. i .. "] " .. tostring(c.Function))
                local fn = c.Function
                if fn then
                    for j = 1, 15 do
                        local ok2, uv = pcall(getupvalue, fn, j)
                        if not ok2 or uv == nil then break end
                        local tt = typeof(uv)
                        local vv = tostring(uv)
                        if (tt == "table" or tt == "userdata") and uv.Name then
                            vv = vv .. " [Name=" .. uv.Name .. "]"
                        end
                        log("    UV[" .. j .. "] " .. tt .. " = " .. vv)
                    end
                end
            end
        end
    end

    log("\n=== NEARBY REMOTES ===")
    local root = playBtn
    for _ = 1, 3 do if root.Parent then root = root.Parent end end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            log("  " .. obj.ClassName .. " : " .. obj.Name)
        end
    end

    log("\n=== LIKELY PLAY REMOTES (RS) ===")
    local kws = {"play","load","spawn","ready","enter","start","begin","join"}
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            for _, kw in ipairs(kws) do
                if n:find(kw) then
                    log("  " .. obj.ClassName .. " : " .. obj:GetFullName())
                    break
                end
            end
        end
    end
end

--======================================================================
-- GUI HIỆN KẾT QUẢ
--======================================================================
local gui = Instance.new("ScreenGui")
gui.Name = "TonKiDumpGui"
gui.ResetOnSpawn = false
gui.Parent = CG

local frame = Instance.new("Frame")
frame.Size = UDim2.new(1, 0, 1, 0)
frame.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
frame.BorderSizePixel = 0
frame.Parent = gui

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 80, 0, 32)
btn.Position = UDim2.new(1, -90, 0, 10)
btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
btn.Text = "ĐÓNG"
btn.TextColor3 = Color3.new(1,1,1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
btn.Parent = frame
btn.MouseButton1Click:Connect(function() gui:Destroy() end)

local copyBtn = Instance.new("TextButton")
copyBtn.Size = UDim2.new(0, 120, 0, 32)
copyBtn.Position = UDim2.new(1, -220, 0, 10)
copyBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 60)
copyBtn.Text = "COPY"
copyBtn.TextColor3 = Color3.new(1,1,1)
copyBtn.Font = Enum.Font.GothamBold
copyBtn.TextSize = 14
copyBtn.Parent = frame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -20, 1, -60)
scroll.Position = UDim2.new(0, 10, 0, 50)
scroll.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 8
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.Parent = frame

local layout = Instance.new("UIListLayout")
layout.Parent = scroll
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, 2)

local result = table.concat(OUT, "\n")
for i, line in ipairs(OUT) do
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 18)
    lbl.BackgroundTransparency = 1
    lbl.Text = line
    lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 12
    lbl.TextWrapped = false
    lbl.LayoutOrder = i
    lbl.Parent = scroll
end

copyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        pcall(function() setclipboard(result) end)
        copyBtn.Text = "COPIED!"
        task.wait(1)
        copyBtn.Text = "COPY"
    else
        copyBtn.Text = "NO CLIP"
        task.wait(1)
        copyBtn.Text = "COPY"
    end
end)

if setclipboard then
    pcall(function() setclipboard(result) end)
    print("[TonKi Hub] Đã copy kết quả vào clipboard.")
end

return result
