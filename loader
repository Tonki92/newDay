--======================================================================
-- DETECT PUZZLE
--======================================================================
local function detectPuzzle()
    local plg = LP:FindFirstChild("PlayerGui")
    if not plg then return nil, nil end

    if knownContainer and knownContainer.Parent then
        local tiles = {}
        for _, c in ipairs(knownContainer:GetChildren()) do
            if c:IsA("ImageButton") then table.insert(tiles, c) end
        end
        if #tiles == 16 then return knownContainer, tiles end
    end

    for _, g in ipairs(plg:GetDescendants()) do
        if (g:IsA("Frame") or g:IsA("ScreenGui") or g:IsA("ScrollingFrame"))
        and g.Visible and g.Enabled ~= false then
            local tiles = {}
            for _, c in ipairs(g:GetChildren()) do
                if c:IsA("ImageButton") and c.Visible then table.insert(tiles, c) end
            end
            if #tiles == 16 then
                knownContainer = g
                return g, tiles
            end
        end
    end

    for _, g in ipairs(plg:GetDescendants()) do
        if g:IsA("Folder") or g:IsA("Frame") then
            local tiles = {}
            for _, c in ipairs(g:GetDescendants()) do
                if c:IsA("ImageButton") and c.Visible then
                    table.insert(tiles, c)
                    if #tiles > 16 then break end
                end
            end
            if #tiles == 16 then
                knownContainer = g
                return g, tiles
            end
        end
    end

    return nil, nil
end

--======================================================================
-- BUILD GRID
--======================================================================
local function buildGrid(tiles)
    local xs, ys = {}, {}
    for _, t in ipairs(tiles) do
        table.insert(xs, t.AbsolutePosition.X)
        table.insert(ys, t.AbsolutePosition.Y)
    end
    table.sort(xs); table.sort(ys)

    local function cluster(vals)
        local out = {}
        for _, v in ipairs(vals) do
            if #out == 0 or math.abs(v - out[#out]) > 5 then
                table.insert(out, v)
            end
        end
        return out
    end
    local cols = cluster(xs)
    local rows = cluster(ys)
    if #cols ~= 4 or #rows ~= 4 then return nil end

    local grid = {}
    for r = 1, 4 do grid[r] = {} end

    for _, t in ipairs(tiles) do
        local px, py = t.AbsolutePosition.X, t.AbsolutePosition.Y
        local col, row = nil, nil
        for i, cx in ipairs(cols) do if math.abs(px - cx) <= 5 then col = i end end
        for i, cy in ipairs(rows) do if math.abs(py - cy) <= 5 then row = i end end
        if row and col and not grid[row][col] then
            grid[row][col] = {
                btn = t,
                img = t.Image or "",
                lo = t.LayoutOrder or -1,
                name = t.Name,
                row = row, col = col,
            }
        end
    end

    for r = 1, 4 do
        for c = 1, 4 do
            if not grid[r][c] then return nil end
        end
    end
    return grid
end

--======================================================================
-- HYPOTHESIS
--======================================================================
local function getIdHypo(tile, hypo)
    if hypo == 1 then
        if tile.img == "" then return 0 end
        return tonumber(tile.img:match("(%d+)$")) or 0
    elseif hypo == 2 then
        return tile.lo
    elseif hypo == 3 then
        return tonumber(tile.name:match("(%d+)")) or 0
    end
    return 0
end

local function gridToIds(grid, hypo)
    local ids = {}
    for r = 1, 4 do
        ids[r] = {}
        for c = 1, 4 do
            ids[r][c] = getIdHypo(grid[r][c], hypo)
        end
    end
    return ids
end

local function buildGoalHypo(ids, emptyId)
    local all = {}
    for r = 1, 4 do
        for c = 1, 4 do
            table.insert(all, ids[r][c])
        end
    end
    table.sort(all)

    local goal = {}
    local idx = 1
    for r = 1, 4 do
        goal[r] = {}
        for c = 1, 4 do
            if r == 4 and c == 4 then
                goal[r][c] = emptyId
            else
                goal[r][c] = all[idx]
                idx = idx + 1
            end
        end
    end
    return goal
end

local function findEmpty(grid)
    for r = 1, 4 do
        for c = 1, 4 do
            local t = grid[r][c]
            if t.img == "" or t.btn.ImageTransparency >= 0.99 then
                return r, c
            end
        end
    end
    return nil, nil
end

--======================================================================
-- A*
--======================================================================
local function key(g)
    local s = ""
    for r = 1, 4 do
        for c = 1, 4 do s = s .. tostring(g[r][c]) .. "," end
    end
    return s
end

local function manhattan(g, goal)
    local sum = 0
    local map = {}
    for r = 1, 4 do
        for c = 1, 4 do
            map[goal[r][c]] = {r=r, c=c}
        end
    end
    for r = 1, 4 do
        for c = 1, 4 do
            local v = g[r][c]
            if v ~= 0 and map[v] then
                sum = sum + math.abs(r - map[v].r) + math.abs(c - map[v].c)
            end
        end
    end
    return sum
end

local function clone(g)
    local ng = {}
    for r = 1, 4 do
        ng[r] = {}
        for c = 1, 4 do ng[r][c] = g[r][c] end
    end
    return ng
end

local function findZero(g)
    for r = 1, 4 do
        for c = 1, 4 do if g[r][c] == 0 then return r, c end end
    end
end

local function solveAStar(start, goal, maxIter)
    maxIter = maxIter or 500000
    local goalK = key(goal)
    if key(start) == goalK then return {} end

    local open = {}
    local function push(n)
        table.insert(open, n)
        local i = #open
        while i > 1 do
            local p = math.floor(i/2)
            if open[p].f <= open[i].f then break end
            open[p], open[i] = open[i], open[p]
            i = p
        end
    end
    local function pop()
        local top = open[1]
        open[1] = open[#open]; open[#open] = nil
        local i = 1
        while true do
            local l, r = i*2, i*2+1
            local s = i
            if l <= #open and open[l].f < open[s].f then s = l end
            if r <= #open and open[r].f < open[s].f then s = r end
            if s == i then break end
            open[i], open[s] = open[s], open[i]
            i = s
        end
        return top
    end

    push({ g = clone(start), gc = 0, f = manhattan(start, goal), parent = nil, move = nil, k = key(start) })
    local visited = { [key(start)] = 0 }

    local iter = 0
    while #open > 0 do
        iter = iter + 1
        if iter > maxIter then return nil, "iter limit" end

        local cur = pop()
        if cur.k == goalK then
            local path = {}
            local n = cur
            while n and n.move do
                table.insert(path, 1, n.move)
                n = n.parent
            end
            return path
        end

        local er, ec = findZero(cur.g)
        local dirs = {{er-1,ec},{er+1,ec},{er,ec-1},{er,ec+1}}
        for _, d in ipairs(dirs) do
            local nr, nc = d[1], d[2]
            if nr >= 1 and nr <= 4 and nc >= 1 and nc <= 4 then
                local ng = clone(cur.g)
                ng[er][ec], ng[nr][nc] = ng[nr][nc], ng[er][ec]
                local k = key(ng)
                if not visited[k] or visited[k] > cur.gc + 1 then
                    visited[k] = cur.gc + 1
                    push({
                        g = ng, gc = cur.gc + 1,
                        f = cur.gc + 1 + manhattan(ng, goal),
                        parent = cur,
                        move = { from = {er,ec}, to = {nr,nc} },
                        k = k,
                    })
                end
            end
        end
    end
    return nil, "no solution"
end

--======================================================================
-- DO MOVE
--======================================================================
local function doMove(fromR, fromC, toR, toC)
    if not currentGrid then return false end
    local tile = currentGrid[toR] and currentGrid[toR][toC]
    if not tile or not tile.btn then return false end

    local btn = tile.btn
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
    end
    if not firesignal then
        local ok, conns = pcall(getconnections, btn.MouseButton1Click)
        if ok and conns then
            for _, c in ipairs(conns) do pcall(function() c:Fire() end) end
        end
    end
    currentGrid[fromR][fromC], currentGrid[toR][toC] =
        currentGrid[toR][toC], currentGrid[fromR][fromC]
    return true
end

--======================================================================
-- MAIN LOOP
--======================================================================
local AutoSolve = true
local MoveDelay = 0.12

spawn(function()
    while true do
        task.wait(1)
        if not AutoSolve then continue end

        local cont, tiles = detectPuzzle()
        if not cont then
            if found then
                add("[State] Puzzle đóng. Chờ lần sau...")
                found = false
                currentGrid = nil
                solvePath = nil
                solveAttempts = 0
                lastGridKey = ""
            end
            continue
        end

        local grid = buildGrid(tiles)
        if not grid then
            add("[X] Build grid fail")
            continue
        end
        currentGrid = grid

        if not found then
            found = true
            solveAttempts = 0
            add("\n[✓] Đã phát hiện puzzle 4x4! Container: " .. cont:GetFullName())
            add("=== TILE DUMP ===")
            for r = 1, 4 do
                for c = 1, 4 do
                    local t = grid[r][c]
                    add(("[%d,%d] N=%s LO=%d Img=%s"):format(
                        r, c, t.name, t.lo, (t.img == "" and "EMPTY" or t.img:sub(-30))))
                end
            end
        end

        local curKey = key(gridToIds(grid, 1))
        if curKey == lastGridKey then continue end
        lastGridKey = curKey

        solveAttempts = solveAttempts + 1
        if solveAttempts <= 3 then
            add("[Try] Hypothesis #" .. solveAttempts)
            local ids = gridToIds(grid, solveAttempts)
            local er, ec = findEmpty(grid)
            if not er then
                add("  → không tìm được empty tile")
                continue
            end
            local emptyId = ids[er][ec]
            if solveAttempts == 1 and emptyId ~= 0 then
                ids[er][ec] = 0
                emptyId = 0
            end
            add("  → Empty: [" .. er .. "," .. ec .. "] ID=" .. tostring(emptyId))

            local goal = buildGoalHypo(ids, emptyId)
            add("  → Goal:")
            for r = 1, 4 do
                local row = "     "
                for c = 1, 4 do row = row .. tostring(goal[r][c]) .. " " end
                add(row)
            end

            add("  → Chạy A*...")
            local t0 = tick()
            local path, err = solveAStar(ids, goal, 200000)
            local dt = tick() - t0
            if path then
                add(("  → SOLVED! %d moves, %.2fs"):format(#path, dt))
                solvePath = path
                task.spawn(function()
                    add("  → Bắt đầu thực thi...")
                    for i, m in ipairs(path) do
                        doMove(m.from[1], m.from[2], m.to[1], m.to[2])
                        task.wait(MoveDelay)
                    end
                    add("  → Xong!")
                end)
                break
            else
                add("  → Fail: " .. tostring(err))
            end
        end
    end
end)

