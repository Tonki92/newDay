-- UI SYSTEM (FIXED)
-- ============================================================================

local UISystem = {}
local MainGui, MainFrame, MenuVisible = nil, nil, true
local IconDragging, MenuDragging = false, false

function UISystem:CreateUI()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    
    MainGui = Instance.new("ScreenGui")
    MainGui.Name = "TonKiHubGUI"
    MainGui.ResetOnSpawn = false
    MainGui.Parent = playerGui
    
    -- ICON TOGGLE (DRAGGABLE)
    local iconToggle = Instance.new("TextButton")
    iconToggle.Name = "IconToggle"
    iconToggle.Size = UDim2.new(0, 50, 0, 50)
    iconToggle.Position = UDim2.new(0.85, 0, 0.5, -25)
    iconToggle.BackgroundColor3 = Color3.fromRGB(200, 100, 180)
    iconToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
    iconToggle.TextSize = 28
    iconToggle.Font = Enum.Font.GothamBold
    iconToggle.Text = "≡"
    iconToggle.BorderColor3 = Color3.fromRGB(250, 250, 250)
    iconToggle.BorderSizePixel = 2
    iconToggle.Parent = MainGui
    
    local iconStartPos = nil
    local iconMouseStart = nil
    
    iconToggle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            IconDragging = true
            iconStartPos = iconToggle.Position
            iconMouseStart = LocalPlayer:GetMouse().Position
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            IconDragging = false
        end
    end)
    
    RunService.RenderStepped:Connect(function()
        if IconDragging and iconStartPos and iconMouseStart then
            local mouse = LocalPlayer:GetMouse()
            local delta = mouse.Position - iconMouseStart
            iconToggle.Position = iconStartPos + UDim2.new(0, delta.X, 0, delta.Y)
        end
    end)
    
    iconToggle.MouseButton1Click:Connect(function()
        task.wait(0.2)
        if not IconDragging then
            MenuVisible = not MenuVisible
            MainFrame.Visible = MenuVisible
        end
    end)
    
    -- MAIN FRAME
    MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0.18, 0, 0.85, 0)
    MainFrame.Position = UDim2.new(0.01, 0, 0.075, 0)
    MainFrame.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
    MainFrame.BorderColor3 = Color3.fromRGB(250, 250, 250)
    MainFrame.BorderSizePixel = 2
    MainFrame.Visible = true
    MainFrame.Parent = MainGui
    
    local menuStartPos = nil
    local menuMouseStart = nil
    
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            MenuDragging = true
            menuStartPos = MainFrame.Position
            menuMouseStart = LocalPlayer:GetMouse().Position
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            MenuDragging = false
        end
    end)
    
    RunService.RenderStepped:Connect(function()
        if MenuDragging and menuStartPos and menuMouseStart then
            local mouse = LocalPlayer:GetMouse()
            local delta = mouse.Position - menuMouseStart
            MainFrame.Position = menuStartPos + UDim2.new(0, delta.X, 0, delta.Y)
        end
    end)
    
    -- SCROLL FRAME
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Name = "ScrollContent"
    scrollFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.BorderSizePixel = 0
    scrollFrame.ScrollBarThickness = 0
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    scrollFrame.Parent = MainFrame
    
    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 0)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = scrollFrame
    
    -- BUILD SECTIONS
    local layoutOrder = 0
    
    local function addSection(text)
        layoutOrder = layoutOrder + 1
        local section = Instance.new("TextLabel")
        section.Name = text
        section.Size = UDim2.new(1, 0, 0, 30)
        section.BackgroundColor3 = Color3.fromRGB(200, 100, 180)
        section.TextColor3 = Color3.fromRGB(0, 0, 0)
        section.TextSize = 11
        section.Font = Enum.Font.GothamBold
        section.Text = "[ " .. text .. " ]"
        section.BorderColor3 = Color3.fromRGB(250, 250, 250)
        section.BorderSizePixel = 1
        section.LayoutOrder = layoutOrder
        section.Parent = scrollFrame
    end
    
    local function addToggle(label, key, callback)
        layoutOrder = layoutOrder + 1
        local btn = Instance.new("TextButton")
        btn.Name = label
        btn.Size = UDim2.new(1, 0, 0, 25)
        btn.BackgroundColor3 = TonKi.GetSetting(key) and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(5, 5, 5)
        btn.TextColor3 = Color3.fromRGB(250, 250, 250)
        btn.TextSize = 10
        btn.Font = Enum.Font.Ubuntu
        btn.Text = label
        btn.BorderColor3 = Color3.fromRGB(250, 250, 250)
        btn.BorderSizePixel = 1
        btn.LayoutOrder = layoutOrder
        btn.Parent = scrollFrame
        
        btn.MouseButton1Click:Connect(function()
            TonKi.SetSetting(key, not TonKi.GetSetting(key))
            btn.BackgroundColor3 = TonKi.GetSetting(key) and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(5, 5, 5)
            if callback then callback() end
        end)
    end
    
    local function addSlider(label, key, minVal, maxVal)
        layoutOrder = layoutOrder + 1
        local btn = Instance.new("TextButton")
        btn.Name = label
        btn.Size = UDim2.new(1, 0, 0, 25)
        btn.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
        btn.TextColor3 = Color3.fromRGB(250, 250, 250)
        btn.TextSize = 10
        btn.Font = Enum.Font.Ubuntu
        btn.Text = label .. ": " .. TonKi.GetSetting(key)
        btn.BorderColor3 = Color3.fromRGB(250, 250, 250)
        btn.BorderSizePixel = 1
        btn.LayoutOrder = layoutOrder
        btn.Parent = scrollFrame
        
        btn.MouseButton1Click:Connect(function()
            local value = TonKi.GetSetting(key) + 50
            if value > maxVal then value = minVal end
            TonKi.SetSetting(key, value)
            btn.Text = label .. ": " .. value
        end)
    end
    
    -- ADD ALL SECTIONS & BUTTONS
    addSection("FARMING")
    addToggle("Auto Farm Mobs", "auto_farm", function()
        if TonKi.GetSetting("auto_farm") then TonKi.StartAutoFarm() else TonKi.StopAutoFarm() end
    end)
    addToggle("Boss Sweep", "allboss", function()
        if TonKi.GetSetting("allboss") then TonKi.StartBossFarm() else TonKi.StopBossFarm() end
    end)
    addSlider("Mob Distance", "distancemob", 50, 500)
    addSlider("Attack Dist", "distance", 3, 20)
    
    addSection("COMBAT")
    addToggle("Melee", "mele")
    addToggle("Defense", "defense")
    addToggle("Sword", "sword")
    addToggle("Fruit", "fruit")
    
    addSection("STANCE & HAKI")
    addToggle("Buso (Q)", "buso")
    addToggle("Ken (W)", "ken")
    addToggle("Hao (R)", "hao")
    
    addSection("SKILL SPAM")
    addToggle("Skill Z", "z")
    addToggle("Skill X", "x")
    addToggle("Skill C", "c")
    addToggle("Skill V", "v")
    addToggle("Skill F", "f")
    addToggle("Skill B", "b")
    addToggle("Skill E", "e")
    
    addSection("DUNGEON")
    addToggle("Dungeon V2", "dungeon2", function()
        if TonKi.GetSetting("dungeon2") then TonKi.StartDungeonV2() else TonKi.StopDungeonV2() end
    end)
    
    addSection("OPTIONS")
    addToggle("Hide Items", "hidenitemdrop")
    
    layoutOrder = layoutOrder + 1
    local saveBtn = Instance.new("TextButton")
    saveBtn.Name = "SaveBtn"
    saveBtn.Size = UDim2.new(1, 0, 0, 30)
    saveBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
    saveBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    saveBtn.TextSize = 11
    saveBtn.Font = Enum.Font.GothamBold
    saveBtn.Text = "SAVE"
    saveBtn.BorderColor3 = Color3.fromRGB(250, 250, 250)
    saveBtn.BorderSizePixel = 1
    saveBtn.LayoutOrder = layoutOrder
    saveBtn.Parent = scrollFrame
    
    saveBtn.MouseButton1Click:Connect(function()
        TonKi.SaveSettings()
    end)
    
    -- Update canvas size
    listLayout.Changed:Connect(function()
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
    end)
end

