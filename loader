-- Quest confirm helper
local function QuestConfirmed(questName)
    local plg = LP:FindFirstChild("PlayerGui")
    if not plg then return false end
    local qf = plg:FindFirstChild("QuestFrame") or plg:FindFirstChild("Quests")
    if not qf then
        -- fallback: search descendants
        for _, f in ipairs(plg:GetDescendants()) do
            if f:IsA("TextLabel") and f.Text:find(questName) then return true end
        end
        return false
    end
    for _, f in ipairs(qf:GetDescendants()) do
        if f:IsA("TextLabel") and f.Text:find(questName) then return true end
    end
    return false
end

